# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

#<src>           <mnt_point>            <type>  <mnt_flags and options>                            <fs_mgr_flags>
/dev/block/vda    /                      ext4    rw                                                 defaults
/dev/block/vdb    /data                  ext4    rw                                                 wait,fileencryption=ice
/dev/block/vdd    /mnt/vendor/persist    ext4    rw                                                 defaults
/dev/block/vde    /firmware              vfat    ro,context=u:object_r:firmware_file:s0             defaults
/dev/block/vdf    /bt_firmware           vfat    ro,context=u:object_r:bt_firmware_file:s0          defaults
/devices/platform/soc/8804000.sdhci/mmc_host*           /storage/sdcard1       vfat    nosuid,nodev                                         wait,voldmanaged=sdcard1:auto,encryptable=footer
/devices/*/xhci-hcd.*.auto*    /storage/usbotg    vfat    nosuid,nodev    wait,voldmanaged=usbotg:auto,encryptable=userdata
